<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_olive_face_root"
              name="Reconocimiento Facial"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="50"
              groups="olive_hr_attendance_face.group_face_user"/>

    <!-- Operacion diaria. El control de asistencia va primero porque es la
         pantalla que se usa todos los dias y la que alimenta la nomina. -->
    <menuitem id="menu_olive_face_kiosk"
              name="Marcaje por rostro"
              parent="menu_olive_face_root"
              action="action_olive_face_kiosk"
              sequence="0"/>

    <menuitem id="menu_olive_absence_grid"
              name="Control de asistencia"
              parent="menu_olive_face_root"
              action="action_olive_absence_grid"
              sequence="1"/>

    <menuitem id="menu_olive_absence"
              name="Ausencias"
              parent="menu_olive_face_root"
              action="action_olive_attendance_absence"
              sequence="2"/>


    <menuitem id="menu_olive_face_review"
              name="Marcajes para revisar"
              parent="menu_olive_face_root"
              action="action_olive_attendance_punch_review"
              sequence="10"/>

    <menuitem id="menu_olive_face_incidence"
              name="Incidencias de marcaje"
              parent="menu_olive_face_root"
              action="action_olive_attendance_anomaly"
              sequence="5"/>

    <menuitem id="menu_olive_face_anomaly"
              name="Asistencias a revisar"
              parent="menu_olive_face_root"
              action="action_olive_attendance_anomaly_hr"
              sequence="15"/>

    <menuitem id="menu_olive_face_punch"
              name="Todos los marcajes"
              parent="menu_olive_face_root"
              action="action_olive_attendance_punch"
              sequence="20"/>

    <!-- Analisis. No alimenta la nomina: sirve para entender el sitio. -->
    <menuitem id="menu_olive_summary"
              name="Resumen de comportamiento"
              parent="menu_olive_face_root"
              action="action_olive_attendance_summary"
              sequence="6"/>

    <menuitem id="menu_olive_analysis"
              name="Analisis de asistencia"
              parent="menu_olive_face_root"
              action="action_olive_attendance_analysis"
              sequence="7"/>

    <!-- Enrolamiento -->
    <menuitem id="menu_olive_face_consent"
              name="Consentimientos"
              parent="menu_olive_face_root"
              action="action_olive_attendance_consent"
