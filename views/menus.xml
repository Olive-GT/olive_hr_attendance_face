    <!-- Infraestructura -->
    <menuitem id="menu_olive_face_device"
              name="Kioscos"
              parent="menu_olive_face_root"
              action="action_olive_attendance_device"
              sequence="50"/>

    <menuitem id="menu_olive_face_sync_batch"
              name="Sincronizaciones"
              parent="menu_olive_face_root"
              action="action_olive_attendance_sync_batch"
              sequence="60"
              groups="olive_hr_attendance_face.group_face_manager"/>

    <menuitem id="menu_olive_face_model_profile"
              name="Perfiles de modelos"
              parent="menu_olive_face_root"
              action="action_olive_attendance_model_profile"
              sequence="70"
              groups="olive_hr_attendance_face.group_face_manager"/>

