<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Con la hora local guardada como numero, la tabla dinamica y los
         graficos que Odoo ya trae responden solos "¿a que hora entra la gente?".
         No hace falta ningun informe a medida para eso. -->

    <record id="view_hr_attendance_pivot_olive" model="ir.ui.view">
        <field name="name">hr.attendance.pivot.olive</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Analisis de asistencia" sample="1">
                <field name="employee_id" type="row"/>
                <field name="olive_check_in_hour" type="measure"/>
                <field name="olive_check_out_hour" type="measure"/>
                <field name="worked_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_attendance_graph_olive" model="ir.ui.view">
        <field name="name">hr.attendance.graph.olive</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <graph string="Analisis de asistencia" type="line" sample="1">
                <field name="olive_local_date" interval="day"/>
                <field name="olive_check_in_hour" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_olive_attendance_analysis" model="ir.actions.act_window">
        <field name="name">Analisis de asistencia</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavia no hay asistencias</p>
            <p>Las medidas <b>Hora de entrada</b> y <b>Hora de salida</b> se
               promedian como cualquier numero: agrupa por empleado, por dia de la
               semana o por mes para ver el patron.</p>
        </field>
    </record>

    <record id="action_olive_attendance_summary" model="ir.actions.client">
        <field name="name">Resumen de comportamiento</field>
        <field name="tag">olive_attendance_summary</field>
    </record>

</odoo>
